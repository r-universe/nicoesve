	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "latexSymb"]
	path = latexSymb
	url = https://github.com/nicoesve/latexsymb
[submodule "riemstats"]
	path = riemstats
	url = https://github.com/nicoesve/riemstats
[submodule "riemtan"]
	path = riemtan
	url = https://github.com/nicoesve/riemtan
